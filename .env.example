# =============================================================
# .env.example — Tacos Las Cazuelitas
# Copia este archivo como .env y ajusta los valores reales.
# NUNCA subas .env al repositorio.
# =============================================================

# ── PostgreSQL local (docker-compose usa contenedor postgres) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taqueria
POSTGRES_USER=taqueria_user
POSTGRES_PASSWORD=cambia_esto

# ── MinIO local (compatible con S3) ───────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=cambia_esto
MINIO_BUCKET_RAW=taqueria-raw
MINIO_BUCKET_CLEAN=taqueria-clean

# ── Cola de mensajes (rabbitmq=local, sqs=AWS) ─────────────────
QUEUE_BACKEND=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
SQS_QUEUE_URL=
SQS_DLQ_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── API ────────────────────────────────────────────────────────
API_SECRET_KEY=cambia_esto_por_secreto_aleatorio
API_TOKEN=cambia_esto
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Entorno ────────────────────────────────────────────────────
ENV=development
