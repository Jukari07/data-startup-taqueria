{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LecturaEstrictaZonaRawS3",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::taqueria-raw-prod",
        "arn:aws:s3:::taqueria-raw-prod/*"
      ]
    },
    {
      "Sid": "EscrituraEstrictaZonaCleanS3",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::taqueria-clean-prod/*"
      ]
    },
    {
      "Sid": "ConsumoDeColaSQS",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:us-east-1:*:taqueria-pedidos"
    },
    {
      "Sid": "PublicacionEnDLQ",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:sqs:us-east-1:*:taqueria-pedidos-dlq"
    },
    {
      "Sid": "MonitoreoCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
